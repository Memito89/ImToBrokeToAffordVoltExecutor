    -- Content area
    local contentArea = Instance.new("Frame")
    contentArea.Name = "ContentArea"
    contentArea.BackgroundTransparency = 1
    contentArea.Size = UDim2.new(1, -121, 1, -38)
    contentArea.Position = UDim2.new(0, 121, 0, 38)
    contentArea.ClipsDescendants = true
    contentArea.Parent = win

    -- Window object returned to user
    local WinObj = {}
    WinObj._tabs = {}
    WinObj._activeTab = nil

    function WinObj:SelectTab(name)
        for _, t in pairs(self._tabs) do
            local isActive = (t.Name == name)
            -- tab button style
            Tween(t.Button, {BackgroundColor3 = isActive and Theme.SurfaceAlt or Theme.Surface}, 0.12)
            t.Button.Label.TextColor3 = isActive and Theme.Text or Theme.TextMuted
            -- indicator
            t.Button.Indicator.BackgroundTransparency = isActive and 0 or 1
            -- content
            t.Container.Visible = isActive
        end
        self._activeTab = name
    end

    function WinObj:Tab(tabName)
        local tabObj = {Name = tabName}

        -- Tab button
        local btn = Instance.new("TextButton")
        btn.Name = tabName
        btn.BackgroundColor3 = Theme.Surface
        btn.Size = UDim2.new(1, 0, 0, 30)
        btn.Text = ""
        btn.AutoButtonColor = false
        btn.Parent = tabBar
        MakeCorner(btn, 6)

        -- Left accent indicator
        local indicator = Instance.new("Frame")
        indicator.Name = "Indicator"
        indicator.BackgroundColor3 = Theme.Accent
        indicator.Size = UDim2.new(0, 3, 0.7, 0)
        indicator.AnchorPoint = Vector2.new(0, 0.5)
        indicator.Position = UDim2.new(0, 0, 0.5, 0)
        indicator.BackgroundTransparency = 1
        indicator.BorderSizePixel = 0
        indicator.Parent = btn
        MakeCorner(indicator, 2)

        local lbl = MakeLabel(btn, tabName, 12, Theme.TextMuted, Enum.Font.GothamMedium)
        lbl.Name = "Label"
        lbl.Position = UDim2.new(0, 12, 0, 0)
        lbl.Size = UDim2.new(1, -12, 1, 0)
        lbl.TextXAlignment = Enum.TextXAlignment.Left

        -- Content container (scrolling frame)
        local container = Instance.new("ScrollingFrame")
        container.Name = "Tab_" .. tabName
        container.BackgroundTransparency = 1
        container.Size = UDim2.new(1, 0, 1, 0)
        container.Position = UDim2.new(0, 0, 0, 0)
        container.ScrollBarThickness = 2
        container.ScrollBarImageColor3 = Theme.Accent
        container.CanvasSize = UDim2.new(0, 0, 0, 0)
        container.AutomaticCanvasSize = Enum.AutomaticSize.Y
        container.Visible = false
        container.Parent = contentArea

        local innerPad = Instance.new("UIPadding")
        innerPad.PaddingTop    = UDim.new(0, 10)
        innerPad.PaddingBottom = UDim.new(0, 10)
        innerPad.PaddingLeft   = UDim.new(0, 10)
        innerPad.PaddingRight  = UDim.new(0, 14)
        innerPad.Parent = container

        local innerList = Instance.new("UIListLayout")
        innerList.FillDirection = Enum.FillDirection.Vertical
        innerList.Padding = UDim.new(0, 6)
        innerList.SortOrder = Enum.SortOrder.LayoutOrder
        innerList.Parent = container

        tabObj.Button = btn
        tabObj.Container = container

        btn.MouseButton1Click:Connect(function()
            WinObj:SelectTab(tabName)
        end)

        table.insert(WinObj._tabs, tabObj)
        if #WinObj._tabs == 1 then
            WinObj:SelectTab(tabName)
        end

        -- ─────────────────────────────
        --  ELEMENT BUILDERS
        -- ─────────────────────────────

        local Tab = {}
        local order = 0
        local function nextOrder() order = order + 1; return order end

        -- Section header
        function Tab:Section(text)
            local sec = Instance.new("Frame")
            sec.BackgroundTransparency = 1
            sec.Size = UDim2.new(1, 0, 0, 0)
            sec.AutomaticSize = Enum.AutomaticSize.Y
            sec.LayoutOrder = nextOrder()
            sec.Parent = container

            local sl = Instance.new("UIListLayout")
            sl.FillDirection = Enum.FillDirection.Horizontal
            sl.VerticalAlignment = Enum.VerticalAlignment.Center
            sl.Padding = UDim.new(0, 8)
            sl.Parent = sec

            local lbl2 = Instance.new("TextLabel")
            lbl2.BackgroundTransparency = 1
            lbl2.Text = text
            lbl2.TextColor3 = Theme.TextMuted
            lbl2.Font = Enum.Font.GothamBold
            lbl2.TextSize = 10
            lbl2.AutomaticSize = Enum.AutomaticSize.XY
            lbl2.TextXAlignment = Enum.TextXAlignment.Left
            lbl2.Parent = sec

            local line = Instance.new("Frame")
            line.BackgroundColor3 = Theme.Border
            line.BorderSizePixel = 0
            line.Size = UDim2.new(1, -lbl2.TextBounds.X - 16, 0, 1)
            line.Parent = sec
        end

        -- Button
        function Tab:Button(opts2)
            opts2 = opts2 or {}
            local lbl2    = opts2.Label    or "Button"
            local desc2   = opts2.Desc     or ""
            local callback = opts2.Callback or function() end

            local row = Instance.new("TextButton")
            row.BackgroundColor3 = Theme.SurfaceAlt
            row.Size = UDim2.new(1, 0, 0, 0)
            row.AutomaticSize = Enum.AutomaticSize.Y
            row.Text = ""
            row.AutoButtonColor = false
            row.LayoutOrder = nextOrder()
            row.Parent = container
            MakeCorner(row, 6)
            MakeStroke(row, Theme.Border, 1)
            MakePadding(row, 9, 9, 12, 12)

            local rl = Instance.new("UIListLayout")
            rl.FillDirection = Enum.FillDirection.Vertical
            rl.Padding = UDim.new(0, 2)
            rl.Parent = row

            local lt = MakeLabel(row, lbl2, 13, Theme.Text, Enum.Font.GothamMedium)
            lt.Size = UDim2.new(1, 0, 0, 0)
            lt.AutomaticSize = Enum.AutomaticSize.Y
            lt.TextWrapped = true

            if desc2 ~= "" then
                local ld = MakeLabel(row, desc2, 11, Theme.TextMuted)
                ld.Size = UDim2.new(1, 0, 0, 0)
                ld.AutomaticSize = Enum.AutomaticSize.Y
                ld.TextWrapped = true
            end

            row.MouseEnter:Connect(function()
                Tween(row, {BackgroundColor3 = Theme.Surface}, 0.1)
            end)
            row.MouseLeave:Connect(function()
                Tween(row, {BackgroundColor3 = Theme.SurfaceAlt}, 0.1)
            end)
            row.MouseButton1Click:Connect(function()
                Tween(row, {BackgroundColor3 = Theme.AccentDim}, 0.08)
                task.delay(0.12, function()
                    Tween(row, {BackgroundColor3 = Theme.SurfaceAlt}, 0.12)
                end)
                pcall(callback)
            end)

            return row
        end

        -- Toggle
        function Tab:Toggle(opts2)
            opts2 = opts2 or {}
            local lbl2     = opts2.Label    or "Toggle"
            local desc2    = opts2.Desc     or ""
            local default  = opts2.Default  or false
            local callback = opts2.Callback or function() end

            local state = default

            local row = Instance.new("Frame")
            row.BackgroundColor3 = Theme.SurfaceAlt
            row.Size = UDim2.new(1, 0, 0, 0)
            row.AutomaticSize = Enum.AutomaticSize.Y
            row.LayoutOrder = nextOrder()
            row.Parent = container
            MakeCorner(row, 6)
            MakeStroke(row, Theme.Border, 1)
            MakePadding(row, 9, 9, 12, 12)

            -- text side
            local textFrame = Instance.new("Frame")
            textFrame.BackgroundTransparency = 1
            textFrame.Size = UDim2.new(1, -50, 0, 0)
            textFrame.AutomaticSize = Enum.AutomaticSize.Y
            textFrame.Parent = row

            local tfl = Instance.new("UIListLayout")
            tfl.FillDirection = Enum.FillDirection.Vertical
            tfl.Padding = UDim.new(0, 2)
            tfl.Parent = textFrame

            local lt = MakeLabel(textFrame, lbl2, 13, Theme.Text, Enum.Font.GothamMedium)
            lt.Size = UDim2.new(1, 0, 0, 0)
            lt.AutomaticSize = Enum.AutomaticSize.Y
            lt.TextWrapped = true

            if desc2 ~= "" then
                local ld = MakeLabel(textFrame, desc2, 11, Theme.TextMuted)
                ld.Size = UDim2.new(1, 0, 0, 0)
                ld.AutomaticSize = Enum.AutomaticSize.Y
                ld.TextWrapped = true
            end

            -- toggle pill
            local pill = Instance.new("Frame")
            pill.BackgroundColor3 = state and Theme.Toggle_On or Theme.Toggle_Off
            pill.Size = UDim2.new(0, 38, 0, 20)
            pill.Position = UDim2.new(1, -38, 0.5, -10)
            pill.Parent = row
            MakeCorner(pill, 10)

            local knob = Instance.new("Frame")
            knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            knob.Size = UDim2.new(0, 14, 0, 14)
            knob.Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
            knob.Parent = pill
            MakeCorner(knob, 7)

            local btn = Instance.new("TextButton")
            btn.BackgroundTransparency = 1
            btn.Size = UDim2.new(1, 0, 1, 0)
            btn.Text = ""
            btn.Parent = row

            local ToggleObj = {}
            function ToggleObj:Set(val)
                state = val
                Tween(pill, {BackgroundColor3 = state and Theme.Toggle_On or Theme.Toggle_Off}, 0.15)
                Tween(knob, {Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)}, 0.15)
                pcall(callback, state)
            end
            function ToggleObj:Get() return state end

            btn.MouseButton1Click:Connect(function()
                ToggleObj:Set(not state)
            end)

            if default then pcall(callback, true) end
            return ToggleObj
        end

        -- Slider
        function Tab:Slider(opts2)
            opts2 = opts2 or {}
            local lbl2     = opts2.Label    or "Slider"
            local min      = opts2.Min      or 0
            local max      = opts2.Max      or 100
            local default  = opts2.Default  or min
            local suffix   = opts2.Suffix   or ""
            local callback = opts2.Callback or function() end

            local value = math.clamp(default, min, max)

            local row = Instance.new("Frame")
            row.BackgroundColor3 = Theme.SurfaceAlt
            row.Size = UDim2.new(1, 0, 0, 0)
            row.AutomaticSize = Enum.AutomaticSize.Y
            row.LayoutOrder = nextOrder()
            row.Parent = container
            MakeCorner(row, 6)
            MakeStroke(row, Theme.Border, 1)
            MakePadding(row, 10, 10, 12, 12)

            local rl = Instance.new("UIListLayout")
            rl.FillDirection = Enum.FillDirection.Vertical
            rl.Padding = UDim.new(0, 8)
            rl.Parent = row

            -- top row: label + value
            local topRow = Instance.new("Frame")
            topRow.BackgroundTransparency = 1
            topRow.Size = UDim2.new(1, 0, 0, 16)
            topRow.Parent = row

            local lt = MakeLabel(topRow, lbl2, 13, Theme.Text, Enum.Font.GothamMedium)
            lt.Size = UDim2.new(1, -60, 1, 0)
            lt.AutomaticSize = Enum.AutomaticSize.None

            local valLabel = Instance.new("TextLabel")
            valLabel.BackgroundTransparency = 1
            valLabel.Size = UDim2.new(0, 55, 1, 0)
            valLabel.Position = UDim2.new(1, -55, 0, 0)
            valLabel.Text = tostring(value) .. suffix
            valLabel.TextColor3 = Theme.Accent
            valLabel.Font = Enum.Font.GothamBold
            valLabel.TextSize = 12
            valLabel.TextXAlignment = Enum.TextXAlignment.Right
            valLabel.Parent = topRow

            -- slider track
            local track = Instance.new("Frame")
            track.BackgroundColor3 = Theme.Slider_BG
            track.Size = UDim2.new(1, 0, 0, 5)
            track.BorderSizePixel = 0
            track.Parent = row
            MakeCorner(track, 3)

            local fill = Instance.new("Frame")
            fill.BackgroundColor3 = Theme.Slider_Fill
            fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
            fill.BorderSizePixel = 0
            fill.Parent = track
            MakeCorner(fill, 3)

            local handle = Instance.new("Frame")
            handle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            handle.Size = UDim2.new(0, 12, 0, 12)
            handle.AnchorPoint = Vector2.new(0.5, 0.5)
            handle.Position = UDim2.new((value - min) / (max - min), 0, 0.5, 0)
            handle.BorderSizePixel = 0
            handle.ZIndex = 3
            handle.Parent = track
            MakeCorner(handle, 6)

            -- hit area
            local hitbox = Instance.new("TextButton")
            hitbox.BackgroundTransparency = 1
            hitbox.Size = UDim2.new(1, 0, 0, 20)
            hitbox.Position = UDim2.new(0, 0, 0.5, -10)
            hitbox.Text = ""
            hitbox.ZIndex = 4
            hitbox.Parent = track

            local draggingSlider = false

            local function UpdateSlider(x)
                local abs = track.AbsolutePosition.X
                local sz  = track.AbsoluteSize.X
                local pct = math.clamp((x - abs) / sz, 0, 1)
                value = math.floor(min + (max - min) * pct)
                fill.Size = UDim2.new(pct, 0, 1, 0)
                handle.Position = UDim2.new(pct, 0, 0.5, 0)
                valLabel.Text = tostring(value) .. suffix
                pcall(callback, value)
            end

            hitbox.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 then
                    draggingSlider = true
                    UpdateSlider(i.Position.X)
                end
            end)
            hitbox.InputEnded:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 then
                    draggingSlider = false
                end
            end)
            UserInputService.InputChanged:Connect(function(i)
                if draggingSlider and i.UserInputType == Enum.UserInputType.MouseMovement then
                    UpdateSlider(i.Position.X)
                end
            end)
            UserInputService.InputEnded:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 then
                    draggingSlider = false
                end
            end)

            local SliderObj = {}
            function SliderObj:Set(val)
                value = math.clamp(val, min, max)
                local pct = (value - min) / (max - min)
                fill.Size = UDim2.new(pct, 0, 1, 0)
                handle.Position = UDim2.new(pct, 0, 0.5, 0)
                valLabel.Text = tostring(value) .. suffix
                pcall(callback, value)
            end
            function SliderObj:Get() return value end

            pcall(callback, value)
            return SliderObj
        end

        -- Textbox
        function Tab:Input(opts2)
            opts2 = opts2 or {}
            local lbl2       = opts2.Label       or "Input"
            local placeholder = opts2.Placeholder or "Type here..."
            local default    = opts2.Default     or ""
            local callback   = opts2.Callback    or function() end

            local row = Instance.new("Frame")
            row.BackgroundColor3 = Theme.SurfaceAlt
            row.Size = UDim2.new(1, 0, 0, 0)
            row.AutomaticSize = Enum.AutomaticSize.Y
            row.LayoutOrder = nextOrder()
            row.Parent = container
            MakeCorner(row, 6)
            MakeStroke(row, Theme.Border, 1)
            MakePadding(row, 9, 9, 12, 12)

            local rl = Instance.new("UIListLayout")
            rl.FillDirection = Enum.FillDirection.Vertical
            rl.Padding = UDim.new(0, 6)
            rl.Parent = row

            MakeLabel(row, lbl2, 13, Theme.Text, Enum.Font.GothamMedium)

            local box = Instance.new("TextBox")
            box.BackgroundColor3 = Theme.Background
            box.Size = UDim2.new(1, 0, 0, 32)
            box.Text = default
            box.PlaceholderText = placeholder
            box.PlaceholderColor3 = Theme.TextMuted
            box.TextColor3 = Theme.Text
            box.Font = Enum.Font.Gotham
            box.TextSize = 13
            box.ClearTextOnFocus = false
            box.TextXAlignment = Enum.TextXAlignment.Left
            box.BorderSizePixel = 0
            box.Parent = row
            MakeCorner(box, 5)
            MakeStroke(box, Theme.Border, 1)
            MakePadding(box, 0, 0, 8, 8)

            box.Focused:Connect(function()
                Tween(box, {}, 0.1) -- just visual pulse via stroke
                MakeStroke(box, Theme.Accent, 1)
            end)
            box.FocusLost:Connect(function(enter)
                MakeStroke(box, Theme.Border, 1)
                if enter then pcall(callback, box.Text) end
            end)

            local InputObj = {}
            function InputObj:Get() return box.Text end
            function InputObj:Set(v) box.Text = v end

            return InputObj
        end

        -- Dropdown
        function Tab:Dropdown(opts2)
            opts2 = opts2 or {}
            local lbl2     = opts2.Label    or "Dropdown"
            local items    = opts2.Items    or {}
            local default  = opts2.Default  or (items[1] or "")
            local callback = opts2.Callback or function() end

            local selected = default
            local open = false

            local wrapper = Instance.new("Frame")
            wrapper.BackgroundTransparency = 1
            wrapper.Size = UDim2.new(1, 0, 0, 0)
            wrapper.AutomaticSize = Enum.AutomaticSize.Y
            wrapper.LayoutOrder = nextOrder()
            wrapper.ClipsDescendants = false
            wrapper.Parent = container

            local wl = Instance.new("UIListLayout")
            wl.FillDirection = Enum.FillDirection.Vertical
            wl.Padding = UDim.new(0, 4)
            wl.Parent = wrapper

            local row = Instance.new("TextButton")
            row.BackgroundColor3 = Theme.SurfaceAlt
            row.Size = UDim2.new(1, 0, 0, 38)
            row.Text = ""
            row.AutoButtonColor = false
            row.Parent = wrapper
            MakeCorner(row, 6)
            MakeStroke(row, Theme.Border, 1)
            MakePadding(row, 0, 0, 12, 12)

            MakeLabel(row, lbl2, 12, Theme.TextMuted, Enum.Font.Gotham)

            local selLabel = Instance.new("TextLabel")
            selLabel.BackgroundTransparency = 1
            selLabel.Text = selected
            selLabel.TextColor3 = Theme.Text
            selLabel.Font = Enum.Font.GothamMedium
            selLabel.TextSize = 13
            selLabel.Size = UDim2.new(1, -40, 1, 0)
            selLabel.Position = UDim2.new(0, 12, 0, 0)
            selLabel.TextXAlignment = Enum.TextXAlignment.Left
            selLabel.Parent = row

            local arrow = MakeLabel(row, "▾", 14, Theme.TextMuted, Enum.Font.GothamBold)
            arrow.Position = UDim2.new(1, -24, 0.5, -8)
            arrow.Size = UDim2.new(0, 16, 0, 16)
            arrow.TextXAlignment = Enum.TextXAlignment.Center

            -- Dropdown list
            local listFrame = Instance.new("Frame")
            listFrame.BackgroundColor3 = Theme.Surface
            listFrame.Size = UDim2.new(1, 0, 0, 0)
            listFrame.Visible = false
            listFrame.ZIndex = 10
            listFrame.Parent = wrapper
            MakeCorner(listFrame, 6)
            MakeStroke(listFrame, Theme.Border, 1)

            local ll = Instance.new("UIListLayout")
            ll.FillDirection = Enum.FillDirection.Vertical
            ll.Padding = UDim.new(0, 2)
            ll.Parent = listFrame
            MakePadding(listFrame, 4, 4, 4, 4)

            local function BuildList()
                for _, ch in pairs(listFrame:GetChildren()) do
                    if ch:IsA("TextButton") then ch:Destroy() end
                end
                for _, item in ipairs(items) do
                    local opt = Instance.new("TextButton")
                    opt.BackgroundColor3 = Theme.SurfaceAlt
                    opt.Size = UDim2.new(1, 0, 0, 28)
                    opt.Text = item
                    opt.TextColor3 = item == selected and Theme.Accent or Theme.Text
                    opt.Font = Enum.Font.GothamMedium
                    opt.TextSize = 12
                    opt.AutoButtonColor = false
                    opt.ZIndex = 11
                    opt.Parent = listFrame
                    MakeCorner(opt, 4)
                    opt.MouseEnter:Connect(function()
                        Tween(opt, {BackgroundColor3 = Theme.Background}, 0.08)
                    end)
                    opt.MouseLeave:Connect(function()
                        Tween(opt, {BackgroundColor3 = Theme.SurfaceAlt}, 0.08)
                    end)
                    opt.MouseButton1Click:Connect(function()
                        selected = item
                        selLabel.Text = item
                        open = false
                        listFrame.Visible = false
                        Tween(arrow, {TextColor3 = Theme.TextMuted}, 0.1)
                        pcall(callback, item)
                        BuildList()
                    end)
                end
                listFrame.Size = UDim2.new(1, 0, 0, #items * 30 + 8)
            end

            BuildList()

            row.MouseButton1Click:Connect(function()
                open = not open
                listFrame.Visible = open
                Tween(arrow, {TextColor3 = open and Theme.Accent or Theme.TextMuted}, 0.1)
            end)

            local DDObj = {}
            function DDObj:Set(val)
                selected = val
                selLabel.Text = val
                pcall(callback, val)
                BuildList()
            end
            function DDObj:Get() return selected end
            function DDObj:Refresh(newItems)
                items = newItems
                BuildList()
            end

            return DDObj
        end

        -- Label (read-only text)
        function Tab:Label(text, color)
            local lbl2 = Instance.new("TextLabel")
            lbl2.BackgroundTransparency = 1
            lbl2.Text = text or ""
            lbl2.TextColor3 = color or Theme.TextMuted
            lbl2.Font = Enum.Font.Gotham
            lbl2.TextSize = 12
            lbl2.TextXAlignment = Enum.TextXAlignment.Left
            lbl2.TextWrapped = true
            lbl2.Size = UDim2.new(1, 0, 0, 0)
            lbl2.AutomaticSize = Enum.AutomaticSize.Y
            lbl2.LayoutOrder = nextOrder()
            lbl2.Parent = container

            local LblObj = {}
            function LblObj:Set(t) lbl2.Text = t end
            return LblObj
        end

        -- Keybind
        function Tab:Keybind(opts2)
            opts2 = opts2 or {}
            local lbl2     = opts2.Label    or "Keybind"
            local default  = opts2.Default  or Enum.KeyCode.Unknown
            local callback = opts2.Callback or function() end

            local key = default
            local listening = false

            local row = Instance.new("Frame")
            row.BackgroundColor3 = Theme.SurfaceAlt
            row.Size = UDim2.new(1, 0, 0, 38)
            row.LayoutOrder = nextOrder()
            row.Parent = container
            MakeCorner(row, 6)
            MakeStroke(row, Theme.Border, 1)
            MakePadding(row, 0, 0, 12, 12)

            local lt = MakeLabel(row, lbl2, 13, Theme.Text, Enum.Font.GothamMedium)
            lt.Position = UDim2.new(0, 12, 0.5, -8)
            lt.Size = UDim2.new(1, -100, 0, 16)
            lt.AutomaticSize = Enum.AutomaticSize.None

            local keyBtn = Instance.new("TextButton")
            keyBtn.BackgroundColor3 = Theme.Background
            keyBtn.Size = UDim2.new(0, 80, 0, 24)
            keyBtn.Position = UDim2.new(1, -88, 0.5, -12)
            keyBtn.Text = key.Name
            keyBtn.TextColor3 = Theme.Accent
            keyBtn.Font = Enum.Font.GothamBold
            keyBtn.TextSize = 11
            keyBtn.AutoButtonColor = false
            keyBtn.Parent = row
            MakeCorner(keyBtn, 5)
            MakeStroke(keyBtn, Theme.AccentDim, 1)

            keyBtn.MouseButton1Click:Connect(function()
                listening = true
                keyBtn.Text = "..."
                keyBtn.TextColor3 = Theme.TextMuted
            end)

            UserInputService.InputBegan:Connect(function(input, gpe)
                if listening and input.UserInputType == Enum.UserInputType.Keyboard then
                    key = input.KeyCode
                    keyBtn.Text = key.Name
                    keyBtn.TextColor3 = Theme.Accent
                    listening = false
                elseif not listening and input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == key then
                    pcall(callback)
                end
            end)

            local KbObj = {}
            function KbObj:Get() return key end
            function KbObj:Set(k) key = k; keyBtn.Text = k.Name end
            return KbObj
        end

        return Tab
    end

    return WinObj
end

-- ══════════════════════════════════════════
--  INIT
-- ══════════════════════════════════════════
function MemoUI:SetTheme(overrides)
    for k, v in pairs(overrides) do
        if Theme[k] then Theme[k] = v end
    end
end

return MemoUI
