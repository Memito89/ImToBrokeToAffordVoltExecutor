        else
            Tween(win, {Size = UDim2.new(0, width, 0, height)}, 0.2)
        end
    end)

    MakeDraggable(win, titleBar)

    -- Tab bar
    local tabBar = Instance.new("Frame")
    tabBar.Name = "TabBar"
    tabBar.BackgroundColor3 = Theme.Surface
